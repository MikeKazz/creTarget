    title: FlashFry
    authors:
      - family-names: McKenna
        given-names: Aaron
      - family-names: Shendure
        given-names: Jay
    repository-code: "https://github.com/mckennalab/FlashFry"
    notes: "Used for CRISPR target discovery and on/off-target scoring."
  - type: software
    title: launch-dCas9
    authors:
      - family-names: Zhou
        given-names: Wancen
    repository-code: "https://github.com/Wancen/launch-dCas9"
    notes: >-
      Optional CNN-based enhancer/promoter efficacy scoring. Pretrained
