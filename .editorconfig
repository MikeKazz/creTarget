root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,config}]
indent_size = 2

[*.nf]
indent_size = 4

[Makefile]
indent_style = tab

[*.{fa,fasta,fai,bed,narrowPeak,jar,pth,gz,tar}]
insert_final_newline = false
trim_trailing_whitespace = false
