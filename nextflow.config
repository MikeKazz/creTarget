/*
 * crispri-guide-designer
 * Nextflow config: default params + profile includes
 */

manifest {
    name            = 'crispri-guide-designer'
    description     = 'Design and rank CRISPRi guide RNAs for noncoding target regions (hg38)'
    author          = ''
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

params {
    // ---- Required user input (at least one of these two) ----
    snp_bed          = null        // BED of SNP/point targets (hg38)
    enhancer_bed     = null        // BED of enhancer/interval targets (hg38)

    // ---- Optional design behavior ----
    dedup_blast_radius = false     // flag targets within blast_radius_bp of each other (does not merge)
    blast_radius_bp     = 1000     // CRISPRi silencing window, bp
    flank_bp             = 50      // enhancer-type: padding added around each BED interval
    snp_window_bp         = 150    // SNP-type: search window on each side of the point

    // ---- Reference / index caching (auto-managed, no user path needed) ----
    cache_dir         = "${System.getProperty('user.home')}/.crispri-guide-designer"
    reference_version = 'hg38-standard-noalt-nochrM-v1'   // versioned tag of the hosted reference+index bundle
    reference_url_base = 'https://example.org/crispri-guide-designer/releases'  // TODO: real hosting location

    // ---- Local override paths (bypass SETUP_REFERENCE / container pulls) ----
    // For testing directly against an existing cluster install before the
    // hosted reference bundle and Docker images are published. If any of
    // these are set, SETUP_REFERENCE is skipped entirely.
    local_fasta        = null   // e.g. /home/jmorrislab1/mkazemi/bin/hg38.fa
    local_flashfry_jar = null   // e.g. /home/jmorrislab1/mkazemi/bin/FlashFry-assembly-1.15.jar
    local_flashfry_db  = null   // e.g. /home/jmorrislab1/mkazemi/bin/hg38_standard_cas9ngg_db

    // ---- FlashFry ----
    flashfry_max_mismatch   = 3
    flashfry_scoring_metrics = 'doench2014ontarget,doench2016cfd,dangerous,hsu2013,moreno2015,jostandsantos,minot,folding'

    // ---- Output ----
    outdir = 'results'

    // ---- Misc ----
    help = false
}

// Load base process resource config
includeConfig 'conf/base.config'

profiles {
    standard {
        includeConfig 'conf/standard.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    bare {
        // No containers -- assumes java, bedtools, samtools, python3(+pandas)
        // are already on PATH. For testing against an existing local
        // FlashFry install (--local_fasta/--local_flashfry_jar/--local_flashfry_db)
        // before the hosted reference bundle and Docker images exist.
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

// Nice execution reports by default
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
