/*
 * creTarget -- Nextflow pipeline configuration
 *
 * Scheduler support lives entirely in the profiles below. Adding a cluster
 * type is a few lines here, not a new executor implementation.
 */

params {
    // --- Input ---
    snp_bed                 = null
    enhancer_bed            = null

    // --- Reference ---
    fasta                   = null
    flashfry_jar            = null
    flashfry_db             = null

    // --- Region prep ---
    flank_bp                = 50
    snp_window_bp           = 150
    blast_radius_bp         = 1000
    dedup_blast_radius      = false

    // --- FlashFry ---
    chunk_size              = 5000
    max_mismatch            = 3
    scoring_metrics         = 'doench2014ontarget,doench2016cfd,dangerous,hsu2013,moreno2015,jostandsantos,minot,folding'

    // --- Optional annotation ---
    atac_narrowpeak         = null

    run_launch_dcas9        = false
    launch_script           = null
    launch_python           = null
    ckpt_dir                = null

    run_seed_finder         = false
    seed_finder_dir         = null
    seed_finder_python      = null
    seed_finder_min_length  = null
    seed_finder_tss_window  = null

    // --- Output ---
    outdir                  = 'results'
    publish_dir_mode        = 'copy'

    // --- Software provisioning ---
    // Default image for the docker/singularity/apptainer profiles, so
    // `-profile singularity` works with no extra flags. Keep this tag in step
    // with `manifest.version` below -- they are bumped together.
    // Override with --container_image to use your own build.
    container_image         = 'ghcr.io/mikekazz/cretarget:0.2.3'

    // --- Scheduler ---
    queue                   = null   // partition/queue name, when your site needs one
    gpu_gres                = null   // e.g. 'gpu:1' -- requests a GPU for the launch-dCas9 step
    gpu_count               = null   // local executor only: pin tasks round-robin across N GPUs

    // --- Resource ceilings (raised/lowered per profile) ---
    max_cpus                = 16
    max_memory              = '128.GB'
    max_time                = '48.h'

    help                    = false
    version                 = false
}

/*
 * Defaults first, so that a site profile below can override them.
 */
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {

    /* ---- Execution environments ---- */

    standard {
        process.executor = 'local'
    }

    local {
        process.executor = 'local'
    }

    slurm {
        process.executor        = 'slurm'
        // Keep a lid on how many jobs are queued at once. A thousand
        // simultaneous JVMs each reading a multi-GB off-target index will
        // punish a shared filesystem, and your admins will notice.
        executor.queueSize      = 50
        executor.submitRateLimit = '10/1min'
        process.queue           = params.queue
        // SLURM sets CUDA_VISIBLE_DEVICES for a job that requested a GPU.
        process {
            withName: LAUNCH_DCAS9 {
                clusterOptions = params.gpu_gres ? "--gres=${params.gpu_gres}" : null
            }
        }
    }

    // Site profile for boltzmann (single-node SLURM). See conf/boltzmann.config.
    boltzmann {
        includeConfig 'conf/boltzmann.config'
    }

    pbs {
        process.executor        = 'pbspro'
        executor.queueSize      = 50
        executor.submitRateLimit = '10/1min'
        process.queue           = params.queue
    }

    sge {
        process.executor        = 'sge'
        executor.queueSize      = 50
        process.penv            = 'smp'
        process.queue           = params.queue
    }

    lsf {
        process.executor        = 'lsf'
        executor.queueSize      = 50
        // Most LSF sites interpret memory requests per-core.
        executor.perJobMemLimit = true
        process.queue           = params.queue
    }

    /* ---- Software provisioning ---- */

    conda {
        includeConfig 'conf/conda-base.config'
    }

    /*
     * Same environment, faster solver. Needs the binary on PATH. micromamba is
     * a single static download:
     *   curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest \
     *     | tar -xvj bin/micromamba
     */
    mamba {
        includeConfig 'conf/conda-base.config'
        conda.useMamba = true
    }

    micromamba {
        includeConfig 'conf/conda-base.config'
        conda.useMicromamba = true
    }

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
        process.container      = params.container_image
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
        process.container      = params.container_image
    }

    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        conda.enabled          = false
        process.container      = params.container_image
    }

    /* ---- Testing ---- */

    test {
        includeConfig 'conf/test.config'
    }
}

/*
 * Ceilings last: conf/limits.config reads params.max_* after any profile has
 * set them, and clamps every request once all other config has been applied.
 */
includeConfig 'conf/limits.config'

// Keep the JVM from over-reserving on shared login nodes.
env {
    PYTHONNOUSERSITE = 1
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }

manifest {
    name            = 'MikeKazz/creTarget'
    author          = 'Mehrdad Kazemi'
    homePage        = 'https://github.com/MikeKazz/creTarget'
    description     = 'Design, score, and rank CRISPRi guide RNAs for noncoding target regions'
    mainScript      = 'main.nf'
    // 24.04 is the real floor: process.resourceLimits (conf/limits.config)
    // was introduced there. Declaring 23.04 meant the clamp silently did
    // nothing on older versions. 23.x also caps at Java 19, which rules it
    // out on any modern JDK.
    nextflowVersion = '>=24.04.0'
    version         = '0.2.3'
    license         = 'MIT'
}
