/*
 * Resource ceilings, applied last.
 *
 * `resourceLimits` clamps every request -- including anything a site profile
 * set and anything a retry escalated to -- down to what the site can actually
 * satisfy. Without it, an escalating retry can ask for more than the partition
 * allows and get rejected outright rather than merely running slowly.
 * (Nextflow's built-in replacement for the old nf-core check_max() helper,
 * which newer config parsers reject.)
 *
 * This file is included at the very END of nextflow.config for two reasons:
 * it must read params.max_cpus/max_memory/max_time AFTER a profile has set
 * them, and clamping is only meaningful once every other config has had its
 * say. conf/base.config, by contrast, is included BEFORE the profiles so that
 * site profiles can override its defaults.
 */

process {
    resourceLimits = [
        cpus  : params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time as nextflow.util.Duration,
    ]
}
