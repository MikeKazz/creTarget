/*
 * Shared conda settings, included by the `conda`, `mamba` and `micromamba`
 * profiles.
 *
 * These live in their own file rather than being duplicated three times, and
 * the solver choice is a PROFILE rather than a --param because a profile block
 * that reads params.X sees whatever X was when the block was parsed, which
 * makes `--conda_frontend` unreliable. Profiles are selected before config
 * evaluation, so `-profile micromamba` always takes effect.
 */

conda {
    enabled  = true
    channels = ['conda-forge', 'bioconda']

    /*
     * Fail loudly rather than hanging. Conda's classic solver (the default in
     * conda <23.10 without conda-libmamba-solver) can take an hour on this
     * bioconda dependency set; a run that appears frozen with no error is
     * worse than a clear timeout. `-profile micromamba` solves it in seconds.
     */
    createTimeout = '60 min'
}

process {
    conda = "${projectDir}/assets/environment.yml"
}

docker.enabled      = false
singularity.enabled = false
apptainer.enabled   = false
