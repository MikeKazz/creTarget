/*
 * Minimal end-to-end smoke test: tiny inputs, small resources, runs in
 * minutes on a laptop or a CI runner. Requires the reference paths to be
 * supplied; CI builds a synthetic mini-genome for them.
 */
params {
    max_cpus        = 1
    max_memory      = '3.GB'
    max_time        = '1.h'
    chunk_size      = 3
    outdir          = 'results_test'
}
