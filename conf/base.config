/*
 * Base resource requests per process label.
 * Cluster-specific overrides (queue names, etc.) live in conf/slurm.config
 */

process {
    cpus   = 2
    memory = '4 GB'
    time   = '1 h'

    withLabel: 'setup_reference' {
        cpus   = 2
        memory = '4 GB'
        time   = '6 h'   // first-run download can be slow; cached runs skip this entirely
    }

    withLabel: 'flashfry_discover' {
        cpus   = 4
        memory = '14 GB'
        time   = '2 h'
    }

    withLabel: 'flashfry_score' {
        cpus   = 4
        memory = '8 GB'
        time   = '2 h'
    }

    withLabel: 'utils_process' {
        cpus   = 2
        memory = '8 GB'
        time   = '1 h'
    }
}
