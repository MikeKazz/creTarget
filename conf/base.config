/*
 * Default resource requests.
 *
 * Memory and time escalate with task.attempt, so an OOM-killed or
 * timed-out chunk is retried larger rather than failing the run. This is
 * what replaces the old hand-tuned JVM heap constants: FlashFry's -Xmx is
 * derived from task.memory inside the process, so a retry at 2x memory
 * automatically gets a 2x heap.
 *
 * These are DEFAULTS. This file is included before the profiles block so a
 * site profile (e.g. conf/example-singlenode.config) can override any of it.
 * The ceilings that clamp the result live in conf/limits.config, which is
 * included last -- see the comment there.
 */

process {

    cpus   = { 1     * task.attempt }
    memory = { 6.GB  * task.attempt }
    time   = { 4.h   * task.attempt }

    // 137 = OOM-killed, 140 = scheduler resource limit, 143 = SIGTERM.
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { 1 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    withLabel: process_low {
        cpus   = { 2     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { 4     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withLabel: process_high_memory {
        cpus   = { 2     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    // PREP_REGIONS holds every input region in memory to flag linked pairs,
    // so it scales with target count rather than with chunk size.
    withName: PREP_REGIONS {
        cpus   = { 1 }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: FLASHFRY_DISCOVER_SCORE {
        cpus   = { 2     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: ANNOTATE {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    // Add your site's GPU request via clusterOptions if you have one;
    // the CNN runs on CPU otherwise, just more slowly.
    withName: LAUNCH_DCAS9 {
        cpus   = { 4     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: SEED_FINDER {
        cpus   = { 2     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
}
