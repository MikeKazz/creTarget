/*
 * Site profile template.
 *
 * creTarget's built-in profiles (`slurm`, `pbs`, `sge`, `lsf`) are
 * intentionally generic: they select an executor, throttle submissions, and
 * otherwise let your scheduler decide what runs when. For many clusters that
 * is enough:
 *
 *     nextflow run MikeKazz/creTarget -profile slurm,conda \
 *         --queue short --gpu_gres gpu:1 ...
 *
 * You need a site profile only when your cluster has constraints the generic
 * profile cannot know about. Copy this file, fill it in, and register it in
 * the `profiles` block of nextflow.config:
 *
 *     mysite {
 *         includeConfig 'conf/mysite.config'
 *     }
 *
 * Then run with `-profile mysite`. You can also keep it outside the repo
 * entirely and pass it with `-c /path/to/mysite.config`, which avoids
 * carrying a local edit in git.
 *
 * ---------------------------------------------------------------------------
 * HOW TO FIND THE NUMBERS
 *
 * `assets/inspect_cluster.sh` is a read-only survey script. Despite the
 * name it is not specific to that machine -- edit the two paths at the top
 * and run it anywhere. It reports everything referenced below. The questions
 * that actually change this file:
 *
 * 1. Does your scheduler account for memory when placing jobs?
 *      SLURM:  scontrol show config | grep SelectTypeParameters
 *              -> needs CR_MEMORY or CR_CORE_MEMORY
 *    If it does NOT, the scheduler will overcommit the node no matter what
 *    `memory` you request, and you must cap concurrency with maxForks below.
 *
 * 2. Does your scheduler *enforce* the memory it granted?
 *      SLURM:  scontrol show config | grep TaskPlugin
 *              -> task/cgroup enforces; task/none does not
 *    With task/none, a task that exceeds its request is not killed cleanly;
 *    it consumes RAM until the kernel OOM killer picks some victim, possibly
 *    another user's job. Be conservative when this is the case.
 *
 * 3. Is the node shared with work the scheduler cannot see?
 *    An interactive box where people also run things outside the scheduler
 *    needs maxForks, because the scheduler's idea of free memory is wrong.
 *    Compare `AllocMem` against `FreeMem` in `scontrol show node`.
 *
 * 4. Does your partition require anything the generic profile omits?
 *    An account, a QOS, a walltime, a specific GRES string. Those go in
 *    `clusterOptions`.
 *
 * 5. Does the work directory filesystem support file locking?
 *    Nextflow's cache requires it. The survey script runs a flock test.
 *
 * 6. How fast is that filesystem?
 *    The collated genome-wide output is ~63 GB; at 100 MB/s that is ten
 *    minutes of pure write time, and the work directory sees several times
 *    that in traffic.
 * ---------------------------------------------------------------------------
 */

params {
    // Partition / queue name, if your site requires one.
    queue       = null            // e.g. 'short', 'normal', 'gpu'

    // GPU request string for the optional launch-dCas9 step. Leave null to
    // run that step on CPU (slower, but it works).
    gpu_gres    = null            // SLURM e.g. 'gpu:1'

    // Ceilings: no task may exceed these however a retry escalates. Set them
    // to the largest single allocation your partition will actually grant --
    // a request above the limit is usually rejected outright rather than
    // queued, which looks like a pipeline bug.
    max_cpus    = 16
    max_memory  = '128.GB'
    max_time    = '48.h'

    // Regions per parallel task. Larger chunks mean fewer, longer tasks:
    // less scheduling overhead, but a more expensive retry when one fails.
    chunk_size  = 5000
}

process {
    executor = 'slurm'            // or 'pbspro', 'sge', 'lsf', 'local'
    queue    = params.queue

    /*
     * Anything your site requires on every job: an account, a QOS, a
     * reservation. Site-wide options belong here; the GPU request is set on
     * LAUNCH_DCAS9 only, so CPU-only tasks do not idle a GPU.
     */
    // clusterOptions = '--account=myproject --qos=normal'

    /*
     * Per-process resources. The defaults in conf/base.config are sensible
     * starting points and escalate on retry (memory and time multiply by
     * task.attempt), so override only what your site actually needs.
     *
     * The two that matter most:
     */

    withName: PREP_REGIONS {
        // Scales with TOTAL target count, not chunk size: all regions are
        // held in memory at once to flag linked neighbours. ~32 GB is sized
        // for a few million regions; a few thousand needs far less.
        memory = { 32.GB * task.attempt }
    }

    withName: FLASHFRY_DISCOVER_SCORE {
        // The pipeline's main cost. FlashFry's JVM heap is derived from this
        // value at runtime, so raising the request raises the heap -- there
        // are no hardcoded -Xmx values to keep in sync.
        //
        // Set maxForks ONLY if your scheduler does not account for memory,
        // or the node is shared with work it cannot see. Otherwise leave it
        // unset and let the scheduler decide; capping it needlessly just
        // slows the run down.
        memory   = { 24.GB * task.attempt }
        // maxForks = 4
    }

    withName: LAUNCH_DCAS9 {
        // Only used with --run_launch_dcas9.
        //
        // Under a scheduler with a GPU request, the scheduler sets
        // CUDA_VISIBLE_DEVICES and the pipeline leaves it alone -- it will
        // never grab a device allocated to someone else. Set maxForks to
        // your GPU count so tasks do not queue behind each other pointlessly.
        //
        // Without a scheduler (-profile local), nothing allocates GPUs and
        // every task would land on device 0. Pass --gpu_count N instead and
        // the pipeline pins tasks round-robin.
        // clusterOptions = "--gres=${params.gpu_gres}"
        // maxForks       = 4
    }
}

executor {
    // How many jobs Nextflow keeps queued at once. The default is generous;
    // lower it if your site has a submit-rate or queue-depth limit, or if
    // thousands of concurrent JVMs would hammer a shared filesystem.
    queueSize       = 50
    submitRateLimit = '10/1min'
}
