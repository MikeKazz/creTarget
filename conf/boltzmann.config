/*
 * Site profile: boltzmann (Morris lab, CCBR / U Toronto)
 *
 * Usage:  nextflow run ... -profile boltzmann
 *
 * This is ONE site. It is also the worked example to copy when writing a
 * profile for a different cluster -- see conf/site-template.config for a
 * blank version with the reasoning spelled out.
 *
 * Everything below is derived from an actual survey of the machine
 * (assets/inspect_boltzmann.sh), not from guesses:
 *
 *   SLURM 21.08 with exactly ONE node -- boltzmann is both the submit host
 *   and the only compute node. The Nextflow driver therefore competes with
 *   its own tasks for the same 40 CPUs and 125 GB. Submit the driver with
 *   minimal resources (see assets/run_cretarget.sbatch); a driver holding
 *   80 GB starves the work it is waiting on and can deadlock.
 *
 *   SelectTypeParameters = CR_CORE_MEMORY, so SLURM *does* account for
 *   memory when scheduling -- it will not place more than 125 GB of jobs.
 *   That is the good news.
 *
 *   TaskPlugin = task/none, so there is NO cgroup containment: SLURM will
 *   not kill a task that exceeds its --mem. An over-request is not contained;
 *   it just consumes RAM until the kernel OOM killer picks a victim, which
 *   may well be somebody else's job. Hence conservative memory requests.
 *
 *   AllocMem=0 while FreeMem was ~28 GB of 125 GB at survey time: people run
 *   work on this box OUTSIDE SLURM. SLURM cannot see that usage and will
 *   happily schedule against memory that is already in use. The explicit
 *   maxForks values below are the backstop for exactly that, and are the
 *   main reason this profile is more conservative than the generic `slurm`
 *   one.
 *
 *   40 logical CPUs = 20 physical cores, hyperthreaded, 2 NUMA nodes.
 *   FlashFry is not meaningfully multithreaded for our usage, so wide
 *   per-task CPU requests buy nothing and only reduce concurrency.
 *
 *   DefMemPerCPU = 3072 MB, so a task that does not state its memory gets
 *   3 GB/CPU. Every process here states it explicitly.
 *
 *   One partition, `gpu`, default, no time limit. 4 GPUs shared with other
 *   users; SLURM sets CUDA_VISIBLE_DEVICES for jobs requesting --gres=gpu:1.
 *
 *   Storage is two separate NFSv4 servers (verified: different device ids):
 *     /home/jmorrislab1  15 T   -- code, inputs, logs
 *     /home/jmorrislab0  174 T  -- reference, work dir, results
 *   Both pass a flock test, which Nextflow's cache requires. Sequential
 *   write throughput measured ~105 MB/s on both, so the ~63 GB genome-wide
 *   output takes ~10 minutes just to write.
 *
 *   JobAcctGatherType = jobacct_gather/none, so `sacct` reports no MaxRSS.
 *   Read peak memory from Nextflow's own trace.txt instead, which polls
 *   /proc independently of SLURM accounting.
 */

params {
    queue       = 'gpu'
    gpu_gres    = 'gpu:1'

    // Ceilings. No single task may exceed these, whatever a retry escalates
    // to. 64 GB leaves ~60 GB for other users on a 125 GB box.
    max_cpus    = 8
    max_memory  = '64.GB'
    max_time    = '240.h'   // the partition itself is unlimited

    chunk_size  = 5000
}

process {
    executor = 'slurm'
    queue    = params.queue

    withName: PREP_REGIONS {
        // Scales with total target count, not chunk size: every region is
        // held in memory at once to flag linked neighbours. Sized for the
        // full 2.35M-cCRE case.
        cpus     = 1
        memory   = { 32.GB * task.attempt }
        time     = { 12.h * task.attempt }
        maxForks = 1
    }

    withName: FLASHFRY_DISCOVER_SCORE {
        // 24 GB gives discover a 12 GB heap and score a 14 GB heap -- the
        // same range the pre-Nextflow pipeline used successfully
        // (-Xmx14g/-Xmx7g). maxForks 2 means at most 48 GB in flight here.
        // Raise it only after trace.txt shows the real peak RSS AND the box
        // is quiet; remember SLURM cannot see non-SLURM usage.
        cpus     = 2
        memory   = { 24.GB * task.attempt }
        time     = { 24.h * task.attempt }
        maxForks = 2
    }

    withName: ANNOTATE {
        cpus     = 1
        memory   = { 8.GB * task.attempt }
        time     = { 4.h * task.attempt }
        maxForks = 4
    }

    withName: RANK {
        cpus     = 1
        memory   = { 8.GB * task.attempt }
        time     = { 4.h * task.attempt }
        maxForks = 4
    }

    withName: LAUNCH_DCAS9 {
        // One GPU per task, 4 GPUs on the box; SLURM hands out the device.
        // Note the hardware is mixed: 2x RTX 2080 Ti (sm_75) and 2x Pascal
        // (sm_61). torch 2.5.1 ships sm_60 cubins, which are forward
        // compatible within the Pascal major version, so all four work --
        // but the Pascal cards are slower, and a chunk landing on one will
        // take longer than the same chunk on a 2080 Ti.
        cpus           = 4
        memory         = { 16.GB * task.attempt }
        time           = { 24.h * task.attempt }
        maxForks       = 4
        clusterOptions = "--gres=${params.gpu_gres}"
    }

    withName: SEED_FINDER {
        cpus     = 2
        memory   = { 8.GB * task.attempt }
        time     = { 8.h * task.attempt }
        maxForks = 3
    }
}

executor {
    name              = 'slurm'
    // Total concurrent jobs across all processes; the per-process maxForks
    // above do the real gating and this is the backstop.
    queueSize         = 12
    submitRateLimit   = '20/1min'
    // squeue on a one-node cluster is cheap, but there is no reason to poll
    // it aggressively.
    pollInterval      = '15 sec'
    queueStatInterval = '1 min'
}
