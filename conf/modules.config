/*
 * Per-process publishing rules.
 *
 * Only the things a user actually wants are published. Per-chunk
 * intermediates stay in the work directory, where -resume can reuse them
 * and where they do not turn a genome-wide run's output folder into
 * hundreds of thousands of files.
 */

process {

    withName: PREP_REGIONS {
        publishDir = [
            path: { "${params.outdir}/regions" },
            mode: params.publish_dir_mode,
            pattern: "regions.metadata.tsv"
        ]
    }

    withName: SEED_FINDER {
        publishDir = [
            path: { "${params.outdir}/seed_finder" },
            mode: params.publish_dir_mode,
            pattern: "*_raw_hits.csv"
        ]
    }

    withName: RUN_MANIFEST {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode
        ]
    }
}
