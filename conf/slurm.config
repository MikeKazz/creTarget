/*
 * SLURM execution: each process is submitted as its own SLURM job by Nextflow.
 * No manual sbatch scripting needed by the user — just:
 *   nextflow run main.nf -profile slurm,singularity --bed regions.bed
 *
 * EDIT the queue/clusterOptions below to match your cluster's partition/account
 * naming conventions. This is the one file site admins/users are expected to
 * customize.
 */

process {
    executor = 'slurm'
    queue    = 'cc'                 // TODO: set to your cluster's partition name
    // clusterOptions = '--account=your_account'

    withLabel: 'setup_reference' {
        queue = 'cc'
        time  = '6h'
    }
    withLabel: 'flashfry_discover' {
        queue = 'cc'
        cpus  = 8
        memory = '16 GB'
        time  = '10h'
    }
    withLabel: 'flashfry_score' {
        queue = 'cc'
        cpus  = 4
        memory = '8 GB'
        time  = '6h'
    }
}

singularity.enabled = true
singularity.autoMounts = true

executor {
    queueSize = 50   // cap on concurrently submitted jobs; tune per cluster fair-use policy
}
