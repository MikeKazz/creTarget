/*
 * Worked example: a SINGLE-NODE SLURM cluster with shared GPUs.
 *
 *   nextflow run ... -profile singlenode
 *
 * This is a filled-in version of conf/site-template.config, kept because the
 * numbers in it are measured rather than guessed and the reasoning transfers
 * to other sites. Copy it, adjust, and register your copy in the `profiles`
 * block of nextflow.config (or keep it outside the repository and pass it
 * with `-c /path/to/mysite.config`).
 *
 * The site it describes: one node that is both submit host and only compute
 * node, 20 physical cores (40 threads, 2 NUMA nodes), 125 GB RAM shared with
 * other users, 4 shared GPUs, one partition with no time limit, NFS storage.
 *
 * Four properties of that site drive everything below. Check yours before
 * reusing these numbers -- `assets/inspect_cluster.sh` reports all of them.
 *
 * 1. THE DRIVER COMPETES WITH ITS OWN WORK. On a single-node cluster every
 *    CPU and GB the Nextflow driver job holds is unavailable to the tasks it
 *    is waiting on. Submit the driver with minimal resources (1 CPU, ~4 GB);
 *    see assets/run_cretarget.sbatch. A driver holding 80 GB starves the work
 *    and can deadlock -- waiting forever for jobs that can never be scheduled.
 *
 * 2. THE SCHEDULER ACCOUNTS FOR MEMORY, so a reservation -- not actual usage
 *    -- is what limits concurrency:
 *        scontrol show config | grep SelectTypeParameters   # CR_CORE_MEMORY
 *
 * 3. BUT IT DOES NOT ENFORCE IT. With TaskPlugin=task/none there is no cgroup
 *    containment: a task exceeding its --mem is not killed, it just consumes
 *    RAM until the kernel OOM killer picks a victim, possibly someone else's
 *    job. Hence conservative requests.
 *        scontrol show config | grep TaskPlugin
 *
 * 4. THE NODE IS SHARED WITH WORK THE SCHEDULER CANNOT SEE. Compare AllocMem
 *    against FreeMem in `scontrol show node`: if people also run things
 *    outside the scheduler, it will happily schedule against memory already
 *    in use. The explicit maxForks values below are the backstop for that,
 *    and are why this profile is more conservative than the generic `slurm`
 *    one.
 */

params {
    queue       = 'gpu'        // your partition name
    gpu_gres    = 'gpu:1'      // GPU request for the optional launch-dCas9 step

    // Ceilings. No task may exceed these however a retry escalates.
    // 64 GB leaves roughly half a 125 GB box for other users.
    max_cpus    = 8
    max_memory  = '64.GB'
    max_time    = '240.h'

    // SMALL chunks win. FlashFry's runtime is superlinear in regions per
    // chunk (measured: T ~ n^1.32), so 5,000 regions costs 48 min against
    // 6.1 min for 1,000 -- 8.4x the time for 5x the work. The countervailing
    // cost is three scheduler submissions per chunk, but that only matters if
    // the submission rate falls below the completion rate, and it does not.
    //
    // 1000 is measured and safe. Below it the fixed per-task cost (JVM start
    // plus index load) starts to dominate and the model breaks down; measure
    // before going lower.
    chunk_size  = 1000
}

process {
    executor = 'slurm'
    queue    = params.queue

    withName: PREP_REGIONS {
        // Scales with TOTAL target count, not chunk size: every region is held
        // in memory at once to flag linked neighbours. MEASURED at 2.35M
        // regions: 5.2 GB peak, 1.6 min. (An earlier in-process measurement
        // said 2.22 GB, but it instrumented only the Python and missed the
        // `bedtools getfasta` child -- when a step shells out, measuring the
        // interpreter is not measuring the step.)
        cpus     = 1
        memory   = { 12.GB * task.attempt }
        time     = { 4.h * task.attempt }
        maxForks = 1
    }

    withName: FLASHFRY_DISCOVER_SCORE {
        // Tuned from three measured runs on a 10,000-region benchmark, all at
        // chunk_size 1000 unless noted:
        //
        //   24 GB, 2 forks     : 306 s/chunk, peak RSS 3.1-3.7 GB
        //   12 GB, 5 forks     : 343 s/chunk, peak RSS 1.9-2.3 GB
        //   12 GB, chunk 5000  : 2889 s/chunk, peak RSS 6.2 GB
        //
        // Two results that read as counter-intuitive:
        //
        // 1. HALVING the allocation LOWERED peak RSS (3.7 -> 2.3 GB) for
        //    identical work. FlashFry's -Xmx derives from task.memory, and a
        //    JVM grows its heap toward that ceiling before collecting, so peak
        //    RSS measures the CEILING, not the working set. Do not read
        //    peak_rss from a trace as a memory requirement when the heap is
        //    sized from the allocation -- it is circular. The real working set
        //    is ~2 GB per 1,000-region chunk.
        //
        // 2. Each halving of memory cost ~12% in runtime (more GC) but bought
        //    double the concurrency. 10 x 6 GB is the SAME 60 GB reservation
        //    as 5 x 12 GB and finishes a full run in roughly half the time.
        //
        // An OOM still retries at 12 GB, then 18 GB.
        cpus     = 2
        memory   = { 6.GB * task.attempt }
        time     = { 24.h * task.attempt }
        maxForks = 10
    }

    // MEASURED: both are trivial -- 3-4 s and under 200 MB peak per chunk,
    // because each works on one chunk's table and never the whole dataset.
    // These are pure Python, so unlike FlashFry their peak RSS really is the
    // working set.
    withName: ANNOTATE {
        cpus     = 1
        memory   = { 2.GB * task.attempt }
        time     = { 2.h * task.attempt }
        maxForks = 4
    }

    withName: RANK {
        cpus     = 1
        memory   = { 2.GB * task.attempt }
        time     = { 2.h * task.attempt }
        maxForks = 4
    }

    withName: LAUNCH_DCAS9 {
        // One GPU per task. The scheduler sets CUDA_VISIBLE_DEVICES for a job
        // that requested a GPU and the pipeline leaves it alone, so it never
        // claims a device allocated to someone else.
        //
        // Mixed hardware is fine but not uniform: on this site two cards are
        // Turing (sm_75) and two Pascal (sm_61). torch ships sm_60 cubins,
        // forward compatible within the Pascal major version, so all four
        // work -- but a chunk landing on a Pascal card takes longer.
        cpus           = 4
        memory         = { 16.GB * task.attempt }
        time           = { 24.h * task.attempt }
        maxForks       = 4
        // Guarded: an unset --gpu_gres would otherwise interpolate to the
        // literal string "--gres=null", which SLURM rejects outright. Without
        // a GPU request the CNN falls back to CPU, which is slower but works.
        clusterOptions = params.gpu_gres ? "--gres=${params.gpu_gres}" : null
    }

    withName: SEED_FINDER {
        cpus     = 2
        memory   = { 8.GB * task.attempt }
        time     = { 8.h * task.attempt }
        maxForks = 3
    }
}

executor {
    name              = 'slurm'
    // Total concurrent jobs; the per-process maxForks above do the real
    // gating and this is the backstop.
    queueSize         = 30
    // Nextflow submits as slots free up, so this only binds if it falls below
    // the rate at which tasks COMPLETE. At 10 concurrent FlashFry tasks of
    // ~6 min that is under 5 submissions/min across all three processes.
    submitRateLimit   = '30/1min'
    pollInterval      = '15 sec'
    queueStatInterval = '1 min'
}
