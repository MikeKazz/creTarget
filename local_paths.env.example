# local_paths.env.example
#
# Copy this to local_paths.env (gitignored) and fill in YOUR cluster's real
# paths. run_standalone.sh sources local_paths.env automatically -- you
# never need to pass --fasta/--flashfry_jar/--flashfry_db/etc on the command
# line if this is filled in.
#
#   cp local_paths.env.example local_paths.env
#   # then edit local_paths.env with your real paths

FASTA=/path/to/hg38.fa
FLASHFRY_JAR=/path/to/FlashFry-assembly-1.15.jar
FLASHFRY_DB=/path/to/hg38_standard_cas9ngg_db

# launch-dCas9 (enhancer/promoter on-target CNN scoring, optional --run_launch_dcas9 step)
LAUNCH_VENV_PYTHON=/path/to/conda/envs/launch-dCas9/bin/python
LAUNCH_SCRIPT=/path/to/launch-dCas9/launch-dCas9.py
LAUNCH_CKPT_DIR=/path/to/launch-dCas9/checkpoints/

# SLURM resource directives for the launch-dCas9 array jobs -- these are
# CLUSTER-SPECIFIC, not tool-specific. Edit this block per-cluster. Leave a
# value blank to omit that sbatch flag entirely (e.g. no partition, no GPU).
LAUNCH_SBATCH_PARTITION=
LAUNCH_SBATCH_GRES=
LAUNCH_SBATCH_MEM=16G
LAUNCH_SBATCH_CPUS=8
LAUNCH_SBATCH_TIME=2:00:00
